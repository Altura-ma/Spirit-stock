rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function myRestaurantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /restaurants/{restaurantId} {
      allow read: if isAuthenticated() && myRestaurantId() == restaurantId;
      allow write: if isAuthenticated() && myRestaurantId() == restaurantId;
    }

    match /bottles/{bottleId} {
      allow read, update, delete: if isAuthenticated() &&
        myRestaurantId() == resource.data.restaurantId;
      allow create: if isAuthenticated() &&
        myRestaurantId() == request.resource.data.restaurantId;
    }

    match /suppliers/{supplierId} {
      allow read, update, delete: if isAuthenticated() &&
        myRestaurantId() == resource.data.restaurantId;
      allow create: if isAuthenticated() &&
        myRestaurantId() == request.resource.data.restaurantId;
    }

    match /orders/{orderId} {
      // Authenticated restaurant users
      allow read, update, delete: if isAuthenticated() &&
        myRestaurantId() == resource.data.restaurantId;
      allow create: if isAuthenticated() &&
        myRestaurantId() == request.resource.data.restaurantId;

      // Unauthenticated reads — for the serverless order-action function
      allow read: if !isAuthenticated();

      // Unauthenticated status updates — for supplier accept/cancel via email link
      // Only status + date fields can change, and only to accepted/cancelled
      allow update: if !isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'cancelledAt'])
        && request.resource.data.status in ['accepted', 'cancelled', 'refused'];
    }

    match /movements/{movementId} {
      allow read: if isAuthenticated() && myRestaurantId() == resource.data.restaurantId;
      allow create: if isAuthenticated() && myRestaurantId() == request.resource.data.restaurantId;
      allow update, delete: if false;
    }
  }
}
