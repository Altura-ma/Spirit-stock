rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role in ['restaurant', 'supplier']
        && (
          (request.resource.data.role == 'restaurant'
            && request.resource.data.subscriptionStatus == 'pending_checkout') ||
          request.resource.data.role == 'supplier'
        );
      // Billing fields are written only by server-side Stripe webhooks (Admin SDK bypasses rules).
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restaurantName', 'name', 'updatedAt', 'homeWidgets'])
        && (!('homeWidgets' in request.resource.data) || request.resource.data.homeWidgets is list);
      allow delete: if false;
    }

    function userDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function myRestaurantId() {
      return userDoc() != null ? userDoc().get('restaurantId', null) : null;
    }

    function mySupplierId() {
      return userDoc() != null ? userDoc().get('supplierId', null) : null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function mySubscriptionStatus() {
      return userDoc() != null ? userDoc().get('subscriptionStatus', null) : null;
    }

    function hasPaidRestaurantAccess(restaurantId) {
      return isAuthenticated()
        && myRestaurantId() == restaurantId
        && mySubscriptionStatus() in ['trialing', 'active'];
    }

    function validCategory(category) {
      return category in [
        'whisky', 'rhum', 'vodka', 'gin', 'cognac', 'tequila',
        'vin_rouge', 'vin_blanc', 'vin_rose', 'champagne', 'biere',
        'liqueur', 'autre'
      ];
    }

    function validBottle(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.quantity is number && d.quantity >= 0
        && d.minThreshold is number && d.minThreshold >= 0
        && d.price is number && d.price >= 0
        && validCategory(d.category)
        && d.supplierId is string
        && d.restaurantId is string && d.restaurantId.size() > 0;
    }

    function validMovement(d) {
      return d.bottleId is string && d.bottleId.size() > 0
        && d.bottleName is string && d.bottleName.size() > 0 && d.bottleName.size() <= 200
        && validCategory(d.category)
        && d.type in ['sale', 'pos_sale', 'order_received', 'adjustment_add', 'adjustment_remove']
        && d.quantity is number && d.quantity >= 0
        && d.previousQuantity is number && d.previousQuantity >= 0
        && d.newQuantity is number && d.newQuantity >= 0
        && d.restaurantId is string && d.restaurantId.size() > 0;
    }

    match /restaurants/{restaurantId} {
      allow read: if hasPaidRestaurantAccess(restaurantId);
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if hasPaidRestaurantAccess(restaurantId);
    }

    match /bottles/{bottleId} {
      allow read, delete: if isAuthenticated() &&
        hasPaidRestaurantAccess(resource.data.restaurantId);
      allow create: if isAuthenticated()
        && hasPaidRestaurantAccess(request.resource.data.restaurantId)
        && validBottle(request.resource.data);
      allow update: if isAuthenticated()
        && hasPaidRestaurantAccess(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && validBottle(request.resource.data);
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && (
        resource.data.isGlobal == true ||
        hasPaidRestaurantAccess(resource.data.restaurantId) ||
        mySupplierId() == supplierId
      );

      allow create: if isAuthenticated()
        && request.resource.data.isGlobal != true
        && (
          hasPaidRestaurantAccess(request.resource.data.restaurantId) ||
          request.resource.data.restaurantId == ''
        );

      allow update: if isAuthenticated() && (
        (hasPaidRestaurantAccess(resource.data.restaurantId)
          && resource.data.isGlobal != true
          && request.resource.data.isGlobal != true
          && request.resource.data.restaurantId == resource.data.restaurantId) ||
        (mySupplierId() == supplierId
          && request.resource.data.isGlobal != true
          && request.resource.data.restaurantId == resource.data.restaurantId)
      );

      allow delete: if isAuthenticated() &&
        hasPaidRestaurantAccess(resource.data.restaurantId) &&
        resource.data.isGlobal != true;
    }

    match /orders/{orderId} {
      // Restaurant: full access to own orders
      allow read, update, delete: if isAuthenticated() &&
        hasPaidRestaurantAccess(resource.data.restaurantId);
      allow create: if isAuthenticated() &&
        hasPaidRestaurantAccess(request.resource.data.restaurantId);

      // Supplier: read their orders + accept/refuse
      allow read: if isAuthenticated() && mySupplierId() == resource.data.supplierId;
      // pending → accepted/refused, accepted → shipped, ETA editable while active.
      allow update: if isAuthenticated() && mySupplierId() == resource.data.supplierId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'cancelledAt', 'shippedAt', 'estimatedDeliveryDate'])
        && (
          (resource.data.status == 'pending' && request.resource.data.status in ['pending', 'accepted', 'refused']) ||
          (resource.data.status == 'accepted' && request.resource.data.status in ['accepted', 'shipped']) ||
          (resource.data.status == 'shipped' && request.resource.data.status == 'shipped')
        );
    }

    function validInvoice(d) {
      return d.supplierId == mySupplierId()
        && d.kind in ['internal', 'external']
        && d.number is string && d.number.size() > 0 && d.number.size() <= 60
        && d.clientName is string && d.clientName.size() > 0 && d.clientName.size() <= 200
        && d.lines is list && d.lines.size() <= 100
        && d.totalHT is number && d.totalTTC is number
        && d.status in ['draft', 'issued', 'paid'];
    }

    match /invoices/{invoiceId} {
      // Supplier: full management of their own invoices.
      allow read, delete: if isAuthenticated() && mySupplierId() != null
        && mySupplierId() == resource.data.supplierId;
      allow create: if isAuthenticated() && mySupplierId() != null && validInvoice(request.resource.data);
      allow update: if isAuthenticated() && mySupplierId() != null
        && mySupplierId() == resource.data.supplierId
        && validInvoice(request.resource.data);
      // Restaurant: read the issued invoices addressed to them.
      allow read: if isAuthenticated()
        && resource.data.status in ['issued', 'paid']
        && hasPaidRestaurantAccess(resource.data.restaurantId);
    }

    match /service_requests/{requestId} {
      allow read: if isAuthenticated() && hasPaidRestaurantAccess(resource.data.restaurantId);
      allow create: if isAuthenticated()
        && hasPaidRestaurantAccess(request.resource.data.restaurantId)
        && request.resource.data.status == 'requested'
        && request.resource.data.address is string && request.resource.data.address.size() > 0
        && request.resource.data.preferredDate is string;
      allow update, delete: if false;
    }

    match /movements/{movementId} {
      allow read: if isAuthenticated() && hasPaidRestaurantAccess(resource.data.restaurantId);
      allow create: if isAuthenticated()
        && hasPaidRestaurantAccess(request.resource.data.restaurantId)
        && validMovement(request.resource.data);
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /supplier_products/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && mySupplierId() == request.resource.data.supplierId;
      allow update: if isAuthenticated() && mySupplierId() == resource.data.supplierId
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.productId == resource.data.productId
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 2000))
        && (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price >= 0));
      allow delete: if isAuthenticated() && mySupplierId() == resource.data.supplierId;
    }
  }
}
