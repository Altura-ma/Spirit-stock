rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function userDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function myRestaurantId() {
      return userDoc() != null ? userDoc().get('restaurantId', null) : null;
    }

    function mySupplierId() {
      return userDoc() != null ? userDoc().get('supplierId', null) : null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /restaurants/{restaurantId} {
      allow read: if isAuthenticated() && myRestaurantId() == restaurantId;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && myRestaurantId() == restaurantId;
    }

    match /bottles/{bottleId} {
      allow read, update, delete: if isAuthenticated() &&
        myRestaurantId() == resource.data.restaurantId;
      allow create: if isAuthenticated() &&
        myRestaurantId() == request.resource.data.restaurantId;
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && (
        resource.data.isGlobal == true ||
        myRestaurantId() == resource.data.restaurantId
      );
      // Restaurant-owned supplier
      allow create: if isAuthenticated() &&
        myRestaurantId() == request.resource.data.restaurantId;
      // Platform/global supplier — no restaurantId check (user doc may not exist yet)
      allow create: if isAuthenticated() &&
        request.resource.data.isGlobal == true;
      allow update: if isAuthenticated() && (
        (myRestaurantId() == resource.data.restaurantId && resource.data.isGlobal != true) ||
        mySupplierId() == supplierId
      );
      allow delete: if isAuthenticated() &&
        myRestaurantId() == resource.data.restaurantId &&
        resource.data.isGlobal != true;
    }

    match /orders/{orderId} {
      // Restaurant: full access to own orders
      allow read, update, delete: if isAuthenticated() &&
        myRestaurantId() == resource.data.restaurantId;
      allow create: if isAuthenticated() &&
        myRestaurantId() == request.resource.data.restaurantId;

      // Supplier: read their orders + accept/refuse
      allow read: if isAuthenticated() && mySupplierId() == resource.data.supplierId;
      allow update: if isAuthenticated() && mySupplierId() == resource.data.supplierId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'cancelledAt'])
        && request.resource.data.status in ['accepted', 'refused'];

      // Unauthenticated reads — for the serverless order-action function
      allow read: if !isAuthenticated();

      // Unauthenticated status updates — for supplier accept/cancel via email link
      allow update: if !isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'cancelledAt'])
        && request.resource.data.status in ['accepted', 'cancelled', 'refused'];
    }

    match /movements/{movementId} {
      allow read: if isAuthenticated() && myRestaurantId() == resource.data.restaurantId;
      allow create: if isAuthenticated() && myRestaurantId() == request.resource.data.restaurantId;
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      // Any authenticated supplier can create a product reference
      allow create: if isAuthenticated() && mySupplierId() != null
        && request.resource.data.createdBy == mySupplierId();
      // Only the supplier who created the reference can update or delete it
      allow update, delete: if isAuthenticated()
        && mySupplierId() != null
        && resource.data.createdBy == mySupplierId();
    }

    match /supplier_products/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && mySupplierId() == request.resource.data.supplierId;
      allow update, delete: if isAuthenticated() && mySupplierId() == resource.data.supplierId;
    }
  }
}
